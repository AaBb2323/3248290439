"VertexLitGeneric"
{
	"$baseTexture" "models\fate_arcade\saber/boots"
                "$bumpmap" "models\fate_arcade\saber/boots_n"
                $color2 "[ 0.7 0.7 0.7 ]"
	$surfaceprop Flesh

                $normalmapalphaenvmapmask "1"


                $lightwarptexture "models\fate_arcade\saber/armor_ramp"

	$alphatest 0
                $nocull 0

	$phong 1
                "$phongfresnelranges"    "[ 1 1 0.945]"
	$phongalbedotint 1
	$phongexponent 5
	$phongboost 2
                $phongexponenttexture "models\fate_arcade\saber/boots_e"

	$rimlight 1
	$rimlightexponent 5
	$rimlightboost 0.5
	$rimlightmask 1


	$rimmask 1
}