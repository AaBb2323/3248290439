"VertexLitGeneric"
{
	"$baseTexture" "models\fate_arcade\saber/cloth2"
                "$bumpmap" "models\fate_arcade\saber/cloth2_n"
                $color2 "[ 1 1 1]"
	$surfaceprop Flesh

                $normalmapalphaenvmapmask "1"


                $lightwarptexture "models\fate_arcade\saber/cloth_ramp"

	$alphatest 0
                $nocull 0

	$phong 1
                "$phongfresnelranges"    "[0.3 0.5 0.945]"
	$phongalbedotint 1
	$phongexponent 1
	$phongboost 0.1
                $phongexponenttexture "models\fate_arcade\saber/cloth2_e"

	$rimlight 1
	$rimlightexponent 5
	$rimlightboost 0.5
	$rimlightmask 1


	$rimmask 1
}